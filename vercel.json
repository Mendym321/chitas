{
  "rewrites": [
    {
      "source": "/api/rambam-paras",
      "destination": "/api/tanya-enhance?kind=rambam-paras"
    },
    {
      "source": "/api/error-report",
      "destination": "/api/feedback?kind=error"
    },
    {
      "source": "/r/:code",
      "destination": "/api/quiz?page=:code"
    }
  ],
  "functions": {
    "api/quiz.js": {
      "includeFiles": "{fonts/*.ttf,node_modules/satori/dist/index.cjs,node_modules/{@shuding/opentype.js,camelize,color-name,css-background-parser,css-box-shadow,css-color-keywords,css-gradient-parser,css-to-react-native,escape-html,fflate,hex-rgb,linebreak,parse-css-color,postcss-value-parser,tiny-inflate,unicode-trie}/**}"
    }
  }
}
